[Unit]
Description=Probe DSA Seats factual production contracts
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/dsa-seats-factual-monitor.env
ExecStart=/usr/local/sbin/dsa-seats-factual-monitor.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/server/monitoring/data/node-exporter-textfile
UMask=0027
