# Backport the fixed Node executable without rebuilding application assets.
ARG APP_IMAGE
FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS fixed-node
FROM ${APP_IMAGE}
ARG SOURCE_TREE_SHA256
COPY --from=fixed-node /usr/local/bin/node /usr/local/bin/node
ENV NODE_VERSION=22.23.5
LABEL org.opencontainers.image.source-tree-sha256="${SOURCE_TREE_SHA256}"
RUN test "$(node --version)" = "v22.23.5"
