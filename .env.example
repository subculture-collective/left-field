# Local-only defaults. Deployment role URLs must come from secret management.
# DATABASE_URL is retained solely for migrations/bootstrap and local web fallback.
DATABASE_URL=postgresql://dsa_seats:dsa_seats@127.0.0.1:5432/dsa_seats
# WEB_DATABASE_URL=postgresql://web_readonly:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# INGEST_DATABASE_URL=postgresql://ingest_writer:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# RELEASE_PREFLIGHT_DATABASE_URL=postgresql://release_preflight:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# RELEASE_OPERATOR_DATABASE_URL=postgresql://release_operator:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# Optional sanitized stdout JSONL; disabled by default. Correlation IDs are not metric labels.
# OPERATIONAL_SIGNALS=stdout-jsonl
TEST_DATABASE_URL=postgresql://dsa_seats:dsa_seats@localhost:5432/dsa_seats_test
FEATURE_FLAGS=
# Correction intake is disabled unless explicitly enabled. Use deployment secrets, never real values here.
CORRECTION_INTAKE_ENABLED=false
CORRECTION_DATABASE_URL=postgresql://correction_intake:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
CORRECTION_PUBLIC_ORIGIN=https://seats.example.com
CORRECTION_TRUSTED_IP_HEADER=x-edge-client-ip
CORRECTION_CSRF_SECRET=REPLACE_WITH_32_OR_MORE_BYTE_SECRET
CORRECTION_RATE_HMAC_SECRET=REPLACE_WITH_32_OR_MORE_BYTE_SECRET
# Address resolution defaults to disabled. Server-only secrets; do not expose NEXT_PUBLIC values.
ADDRESS_LOOKUP_MODE=disabled
# ADDRESS_LOOKUP_KILL_SWITCH=allow
# ADDRESS_DATABASE_URL=postgresql://address_lookup:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# ADDRESS_PRODUCT_VINTAGE=2025
