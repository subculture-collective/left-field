# Local-only defaults. Deployment role URLs must come from secret management.
# DATABASE_URL is retained solely for migrations/bootstrap and local web fallback.
DATABASE_URL=postgresql://dsa_seats:dsa_seats@127.0.0.1:5432/dsa_seats
# WEB_DATABASE_URL=postgresql://web_readonly:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# INGEST_DATABASE_URL=postgresql://ingest_writer:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# RELEASE_PREFLIGHT_DATABASE_URL=postgresql://release_preflight:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# RELEASE_OPERATOR_DATABASE_URL=postgresql://release_operator:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# LAUNCH_VERIFIER_DATABASE_URL=postgresql://launch_verifier:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# Launch proof publication is disabled by default. Production keys are only read from
# /etc/dsa-seats/launch-review-keys.json (root:process-group, mode 0640).
# Nonproduction requires LAUNCH_REVIEW_KEYS_FILE and RAW_OBJECT_ROOT.
# LAUNCH_REVIEW_KEYS_FILE=/absolute/path/to/launch-review-keys.json
# RAW_OBJECT_ROOT=.raw
# Offline FEC bulk bootstrap reads only these operator-supplied local paths.
# FEC_BULK_ROOT=/absolute/path/to/FEC
# FEC_BULK_MANIFEST=config/dsa-seats/fec-bulk-acquisition.json
# FEC_API_CREDENTIAL=secret-manager-reference-or-runtime-value
# The credential is never consumed by offline FEC bulk inventory/bootstrap and
# live OpenFEC requests send it only as the X-Api-Key header.
# RAW_OBJECT_BUCKET=immutable-production-raw-bucket
# FEC V2 immutable S3 store. Use dedicated credentials; never use generic AWS_* variables.
# FEC_V2_STORE_MODE=production
# FEC_V2_OBJECT_BUCKET=immutable-fec-v2-bucket
# FEC_V2_OBJECT_ENDPOINT=https://minio.example.com
# FEC_V2_S3_REGION=us-east-1
# FEC_V2_S3_ACCESS_KEY_ID=REPLACE_WITH_SECRET
# FEC_V2_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# FEC_V2_S3_SESSION_TOKEN=optional-session-token
# FEC_V2_RETENTION_EVIDENCE_SHA256=lowercase_64_hex_external_retention_evidence
# FEC_V2_ACQUISITION_DATABASE_URL=postgresql://fec_v2_acquisition:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# FEC_V2_REPLAY_VERIFIER_DATABASE_URL=postgresql://fec_v2_replay_verifier:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# FEC_V2_ACQUISITION_PLAN_PATH=/absolute/path/to/sealed-fec-v2-plan.json
# FEC_V2_ACQUISITION_PLAN_SHA256=lowercase_64_hex_sealed_plan_hash
# Retention evidence is an external operator record; do not put credentials or evidence contents here.
# Optional sanitized stdout JSONL; disabled by default. Correlation IDs are not metric labels.
# OPERATIONAL_SIGNALS=stdout-jsonl
TEST_DATABASE_URL=postgresql://dsa_seats:dsa_seats@localhost:5432/dsa_seats_test
FEATURE_FLAGS=
# Signed v2 gates are disabled by default. Production reads only root:dsa-seats-gates
# 0640 /run/dsa-seats/feature-gates.json and its public key at
# /etc/dsa-seats/feature-gate-public-key.json. Signing is performed offline; never add a private key.
# Nonproduction only may override DSA_SEATS_FEATURE_GATES_PATH and DSA_SEATS_FEATURE_GATE_KEY_PATH.
# These optional values are negative-only kill defenses: their absence never enables a feature.
CORRECTION_DATABASE_URL=postgresql://correction_intake:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
CORRECTION_PUBLIC_ORIGIN=https://seats.example.com
CORRECTION_TRUSTED_IP_HEADER=x-edge-client-ip
CORRECTION_CSRF_SECRET=REPLACE_WITH_32_OR_MORE_BYTE_SECRET
CORRECTION_RATE_HMAC_SECRET=REPLACE_WITH_32_OR_MORE_BYTE_SECRET
# CORRECTION_KILL_SWITCH=allow
# CORRECTION_APPROVAL_REVISION=lowercase_64_hex_approved_package_sha256
# ADDRESS_LOOKUP_KILL_SWITCH=allow is a negative-only defense; it cannot enable lookup.
# ADDRESS_DATABASE_URL=postgresql://address_lookup:REPLACE_WITH_SECRET@db.example.com:5432/dsa_seats
# ADDRESS_PRODUCT_VINTAGE=2025
# ADDRESS_APPROVAL_REVISION=lowercase_64_hex_approved_package_sha256
